datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String   @id @default(uuid())
  username      String   @unique
  passwordHash  String
  recoveryToken String   @default("")
  role          String   @default("admin")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Product {
  id        String   @id @default(uuid())
  name      String   @unique
  quantity  Int
  price     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Debt {
  id        String        @id @default(uuid())
  client    String        @unique
  products  DebtProduct[]
  payments  Payment[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model DebtProduct {
  id       String @id @default(uuid())
  debtId   String
  debt     Debt   @relation(fields: [debtId], references: [id], onDelete: Cascade)
  name     String
  quantity Int
  price    Float
}

model Payment {
  id        String   @id @default(uuid())
  debtId    String
  debt      Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  amount    Float
  date      String
  createdAt DateTime @default(now())
}
